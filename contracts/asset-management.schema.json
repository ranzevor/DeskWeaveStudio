{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:asset-management:1",
  "title": "DeskWeaveStudio 资产引用与删除 1.0",
  "$defs": {
    "reference": {
      "type": "object",
      "properties": {
        "ownerKind": {
          "enum": [
            "revision",
            "draft",
            "run",
            "frame",
            "templateCandidateSet",
            "templateNameProposal",
            "templateCommit",
            "observationBaseline",
            "querySnapshot",
            "export",
            "backup",
            "restore",
            "operation",
            "resourceHandle"
          ]
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "ownerKind",
        "ownerId",
        "displayName",
        "assetVersion"
      ],
      "additionalProperties": false
    },
    "referencesParams": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "assetId"
          ]
        },
        {
          "required": [
            "assetVersion"
          ]
        }
      ]
    },
    "referencesResult": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "versionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "enum": [
            "asset",
            "version"
          ]
        },
        "assetVersion": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ownerKind": {
                "enum": [
                  "revision",
                  "draft",
                  "run",
                  "frame",
                  "templateCandidateSet",
                  "templateNameProposal",
                  "templateCommit",
                  "observationBaseline",
                  "querySnapshot",
                  "export",
                  "backup",
                  "restore",
                  "operation",
                  "resourceHandle"
                ]
              },
              "ownerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "assetVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "ownerKind",
              "ownerId",
              "displayName",
              "assetVersion"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "totalReferences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hiddenReferences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assetId",
        "currentVersion",
        "versionCount",
        "scope",
        "assetVersion",
        "snapshotId",
        "snapshotAt",
        "expiresAt",
        "references",
        "totalReferences",
        "hiddenReferences",
        "nextCursor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "asset"
              }
            }
          },
          "then": {
            "properties": {
              "assetVersion": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "assetVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "deleteParams": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedCurrentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "assetId",
        "expectedCurrentVersion"
      ],
      "additionalProperties": false
    },
    "deleteResult": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "deleted": {
          "const": true
        },
        "removedVersionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentCleanup": {
          "const": "deferred"
        }
      },
      "required": [
        "assetId",
        "deleted",
        "removedVersionCount",
        "contentCleanup"
      ],
      "additionalProperties": false
    }
  }
}
