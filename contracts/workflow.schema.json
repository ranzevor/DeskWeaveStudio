{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:workflow:1",
  "title": "DeskWeave 流程 1.0",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "entry": {
      "$ref": "#/$defs/nodeId"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "array",
              "object"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          },
          "default": {
            "$ref": "urn:deskweave:values:1#/$defs/raw"
          }
        },
        "required": [
          "type",
          "required",
          "sensitive"
        ],
        "additionalProperties": false
      }
    },
    "variables": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "urn:deskweave:values:1#/$defs/raw"
      }
    },
    "targets": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "window",
              "display",
              "region",
              "desktop"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "image",
              "trajectory",
              "workflow"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "activeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "callDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "parallelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "inputEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "activeMs",
        "steps",
        "callDepth",
        "parallelCalls",
        "inputEvents"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "urn:deskweave:actions:1"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "$ref": "urn:deskweave:values:1#/$defs/raw"
      }
    },
    "runVariables": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "urn:deskweave:values:1#/$defs/raw"
      }
    },
    "kind": {
      "enum": [
        "workflow",
        "loopBody"
      ],
      "default": "workflow"
    }
  },
  "required": [
    "formatVersion",
    "id",
    "name",
    "entry",
    "parameters",
    "variables",
    "targets",
    "resources",
    "limits",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    }
  }
}
