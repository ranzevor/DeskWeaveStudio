{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:agent:1",
  "title": "Desktop Agent 请求参数与结果 1.0",
  "allOf": [
    {
      "$ref": "urn:deskweave:message:1#/$defs/requestEnvelope"
    },
    {
      "oneOf": [
        {
          "$ref": "#/$defs/lease.acquire"
        },
        {
          "$ref": "#/$defs/lease.renew"
        },
        {
          "$ref": "#/$defs/lease.release"
        },
        {
          "$ref": "#/$defs/target.bind"
        },
        {
          "$ref": "#/$defs/capture.create"
        },
        {
          "$ref": "#/$defs/record.start"
        },
        {
          "$ref": "#/$defs/record.pause"
        },
        {
          "$ref": "#/$defs/record.resume"
        },
        {
          "$ref": "#/$defs/record.finish"
        },
        {
          "$ref": "#/$defs/segment.submit"
        },
        {
          "$ref": "#/$defs/segment.status"
        },
        {
          "$ref": "#/$defs/emergency.stop"
        },
        {
          "$ref": "#/$defs/emergency.rearm"
        },
        {
          "$ref": "#/$defs/resource.open"
        },
        {
          "$ref": "#/$defs/resource.prepare"
        },
        {
          "$ref": "#/$defs/resource.seal"
        },
        {
          "$ref": "#/$defs/lease.pause"
        },
        {
          "$ref": "#/$defs/lease.status"
        },
        {
          "$ref": "#/$defs/lease.resume"
        },
        {
          "$ref": "#/$defs/desktop.topology"
        },
        {
          "$ref": "#/$defs/record.snapshot"
        },
        {
          "$ref": "#/$defs/desktop.capabilities"
        }
      ]
    }
  ],
  "$defs": {
    "lease.acquire": {
      "type": "object",
      "properties": {
        "method": {
          "const": "lease.acquire"
        },
        "params": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "waitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            },
            "interruptPolicy": {
              "enum": [
                "pause",
                "ignore"
              ],
              "default": "pause"
            }
          },
          "required": [
            "runId",
            "targets",
            "waitMs"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "leaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "agentEpoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expiresInMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "leaseId",
            "runId",
            "generation",
            "agentEpoch",
            "expiresInMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "lease.renew": {
      "type": "object",
      "properties": {
        "method": {
          "const": "lease.renew"
        },
        "params": {
          "type": "object",
          "properties": {
            "leaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "leaseId",
            "generation"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "leaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "agentEpoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expiresInMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "leaseId",
            "runId",
            "generation",
            "agentEpoch",
            "expiresInMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "lease.release": {
      "type": "object",
      "properties": {
        "method": {
          "const": "lease.release"
        },
        "params": {
          "type": "object",
          "properties": {
            "leaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "enum": [
                "finished",
                "cancelled",
                "yielded",
                "fault"
              ]
            }
          },
          "required": [
            "leaseId",
            "generation",
            "reason"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cleanup": {
              "enum": [
                "pending",
                "succeeded",
                "failed",
                "notRequired"
              ]
            }
          },
          "required": [
            "generation",
            "cleanup"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "target.bind": {
      "type": "object",
      "properties": {
        "method": {
          "const": "target.bind"
        },
        "params": {
          "type": "object",
          "properties": {
            "selectionGrant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "selectionGrant"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "targetToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "enum": [
                "window",
                "display",
                "region",
                "desktop"
              ]
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "topology": {
              "$ref": "urn:deskweave:recording:1#/$defs/topology"
            }
          },
          "required": [
            "targetToken",
            "displayName",
            "kind",
            "expiresAt"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "desktop"
                  }
                }
              },
              "then": {
                "required": [
                  "topology"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "capture.create": {
      "type": "object",
      "properties": {
        "method": {
          "const": "capture.create"
        },
        "params": {
          "type": "object",
          "properties": {
            "targetToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "roi": {
              "oneOf": [
                {
                  "$ref": "urn:deskweave:vision:1#/$defs/roi"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "targetToken"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "frameId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "resource": {
              "type": "object",
              "properties": {
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "mediaType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              },
              "required": [
                "resourceId",
                "mediaType",
                "length",
                "sha256",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            "targetVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "topologyVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "origin": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          },
          "required": [
            "frameId",
            "resource",
            "targetVersion",
            "topologyVersion",
            "origin",
            "width",
            "height",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "record.start": {
      "type": "object",
      "properties": {
        "method": {
          "const": "record.start"
        },
        "params": {
          "type": "object",
          "properties": {
            "targetToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "coordinateMode": {
              "enum": [
                "physical",
                "relative",
                "event",
                "display"
              ]
            },
            "includePointerMotion": {
              "type": "boolean",
              "description": "默认启用；关闭时仅省略未按住按钮的普通运动，点击/滚轮位置锚点及按钮按住期间全部运动仍记录。"
            },
            "expectedTopologyVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "targetToken",
            "coordinateMode",
            "includePointerMotion",
            "expectedTopologyVersion"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "const": "recording"
            },
            "controlVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "$ref": "urn:deskweave:recording:1#/$defs/source"
            }
          },
          "required": [
            "recordingId",
            "state",
            "controlVersion",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "record.pause": {
      "type": "object",
      "properties": {
        "method": {
          "const": "record.pause"
        },
        "params": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expectedControlVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recordingId",
            "expectedControlVersion"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "enum": [
                "pausing",
                "paused"
              ]
            },
            "controlVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recordingId",
            "state",
            "controlVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "record.resume": {
      "type": "object",
      "properties": {
        "method": {
          "const": "record.resume"
        },
        "params": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expectedControlVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recordingId",
            "expectedControlVersion"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "const": "recording"
            },
            "controlVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recordingId",
            "state",
            "controlVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "record.finish": {
      "type": "object",
      "properties": {
        "method": {
          "const": "record.finish"
        },
        "params": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "expectedControlVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recordingId",
            "expectedControlVersion"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "recordingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "resource": {
              "$ref": "urn:deskweave:service:1#/$defs/asset.read/properties/result"
            },
            "partial": {
              "type": "boolean"
            }
          },
          "required": [
            "recordingId",
            "resource",
            "partial"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "segment.submit": {
      "type": "object",
      "properties": {
        "method": {
          "const": "segment.submit"
        },
        "params": {
          "type": "object",
          "properties": {
            "leaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "segmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "payloadHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "targetToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "operation": {
              "allOf": [
                {
                  "$ref": "urn:deskweave:service:1#/$defs/input.submit/properties/params/properties/operation"
                },
                {
                  "properties": {
                    "params": {
                      "$ref": "#/$defs/resolvedValue"
                    }
                  }
                }
              ]
            },
            "trajectoryRef": {
              "type": "object",
              "properties": {
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "resourceId",
                "sha256"
              ],
              "additionalProperties": false,
              "description": "已封存的完整轨迹；资源整段提交，原生事件按各自期限逐点发送，不能整段瞬时注入。"
            }
          },
          "required": [
            "leaseId",
            "generation",
            "segmentId",
            "payloadHash",
            "targetToken",
            "operation"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "operation": {
                    "properties": {
                      "action": {
                        "const": "input.trajectory"
                      }
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "trajectoryRef"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "trajectoryRef"
                  ]
                }
              }
            }
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "segmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "enum": [
                "accepted",
                "running",
                "sent",
                "rejected",
                "uncertain",
                "paused"
              ]
            },
            "cleanup": {
              "enum": [
                "pending",
                "succeeded",
                "failed",
                "notRequired"
              ]
            },
            "agentEpoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "pauseId": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "segmentId",
            "state",
            "cleanup",
            "agentEpoch"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "paused"
                  }
                }
              },
              "then": {
                "required": [
                  "pauseId"
                ],
                "properties": {
                  "pauseId": {
                    "type": "string"
                  },
                  "cleanup": {
                    "enum": [
                      "succeeded",
                      "notRequired"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "pauseId": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "segment.status": {
      "type": "object",
      "properties": {
        "method": {
          "const": "segment.status"
        },
        "params": {
          "type": "object",
          "properties": {
            "segmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "payloadHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "segmentId",
            "payloadHash"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "segmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "enum": [
                "accepted",
                "running",
                "sent",
                "rejected",
                "uncertain",
                "paused"
              ]
            },
            "cleanup": {
              "enum": [
                "pending",
                "succeeded",
                "failed",
                "notRequired"
              ]
            },
            "agentEpoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "pauseId": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "segmentId",
            "state",
            "cleanup",
            "agentEpoch"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "paused"
                  }
                }
              },
              "then": {
                "required": [
                  "pauseId"
                ],
                "properties": {
                  "pauseId": {
                    "type": "string"
                  },
                  "cleanup": {
                    "enum": [
                      "succeeded",
                      "notRequired"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "pauseId": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "emergency.stop": {
      "type": "object",
      "properties": {
        "method": {
          "const": "emergency.stop"
        },
        "params": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "state": {
              "const": "locked"
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cleanup": {
              "enum": [
                "pending",
                "succeeded",
                "failed",
                "notRequired"
              ]
            }
          },
          "required": [
            "state",
            "generation",
            "cleanup"
