{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:values:1",
  "title": "流程值与数据表达式",
  "$defs": {
    "raw": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 262144
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/raw"
          }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": {
            "$ref": "#/$defs/raw"
          }
        }
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 262144
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "not": {
              "enum": [
                "$expr",
                "$literal"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "$ref": "#/$defs/expressionValue"
        },
        {
          "type": "object",
          "properties": {
            "$literal": {
              "$ref": "#/$defs/raw"
            }
          },
          "required": [
            "$literal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expressionValue": {
      "type": "object",
      "properties": {
        "$expr": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "$expr"
      ],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "path"
            },
            "path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "prefixItems": [
                {
                  "enum": [
                    "inputs",
                    "vars",
                    "prev",
                    "calls",
                    "runtime",
                    "run"
                  ]
                }
              ],
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 999999
                  }
                ]
              }
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "not",
                "length"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "equal",
                "notEqual",
                "less",
                "lessEqual",
                "greater",
                "greaterEqual",
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "coalesce"
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/value"
}
