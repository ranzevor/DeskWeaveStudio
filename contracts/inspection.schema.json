{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:inspection:1",
  "title": "DeskWeaveStudio 版本与运行检查 1.0",
  "$defs": {
    "revisionParams": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "required": [
        "workflowId"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parentRevision": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "revision",
        "parentRevision",
        "name",
        "createdAt",
        "definitionHash"
      ],
      "additionalProperties": false
    },
    "revisionPage": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "headRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:deskweave:inspection:1#/$defs/revision"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workflowId",
        "headRevision",
        "snapshotId",
        "snapshotAt",
        "expiresAt",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "connectionListParams": {
      "type": "object",
      "properties": {
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "connectionSummary": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "credentialPresent": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "connectionId",
        "name",
        "version",
        "endpoint",
        "model",
        "credentialPresent",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "connectionPage": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:deskweave:inspection:1#/$defs/connectionSummary"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "snapshotId",
        "snapshotAt",
        "expiresAt",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "variableEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "valueType": {
          "enum": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        },
        "visibility": {
          "enum": [
            "visible",
            "redacted",
            "unavailable"
          ]
        },
        "value": {
          "$ref": "urn:deskweave:values:1#/$defs/raw"
        },
        "valueResource": {
          "$ref": "urn:deskweave:service:1#/$defs/asset.read/properties/result"
        },
        "reason": {
          "enum": [
            "resourceExpired",
            "notCaptured"
          ]
        }
      },
      "required": [
        "name",
        "valueType",
        "visibility"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "visible"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "value"
                ],
                "not": {
                  "required": [
                    "valueResource"
                  ]
                }
              },
              {
                "required": [
                  "valueResource"
                ],
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "valueResource"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    "variablesParams": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "frameId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "inputs",
            "local",
            "shared",
            "previous",
            "outputs"
          ]
        },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "required": [
        "runId",
        "snapshotId",
        "frameId",
        "scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "shared"
              }
            }
          },
          "then": {
            "properties": {
              "frameId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "frameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cursor": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "snapshotId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "variablesPage": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "controlVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frameId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "inputs",
            "local",
            "shared",
            "previous",
            "outputs"
          ]
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "urn:deskweave:inspection:1#/$defs/variableEntry"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runId",
        "snapshotId",
        "dataVersion",
        "controlVersion",
        "frameId",
        "scope",
        "snapshotAt",
        "expiresAt",
        "total",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "shared"
              }
            }
          },
          "then": {
            "properties": {
              "frameId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "frameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "variablesChanged": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "controlVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frameId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "inputs",
            "local",
            "shared",
            "previous",
            "outputs"
          ]
        }
      },
      "required": [
        "runId",
        "dataVersion",
        "controlVersion",
        "frameId",
        "scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "shared"
              }
            }
          },
          "then": {
            "properties": {
              "frameId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "frameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/variablesPage"
}
