{
  "formatVersion": "1.0",
  "id": "check-download",
  "name": "校验下载结果",
  "entry": "locate",
  "parameters": {
    "month": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "default": "2026-10"
    }
  },
  "variables": {
    "matchResult": null,
    "checkResult": null,
    "downloadComplete": false
  },
  "targets": {
    "main": {
      "kind": "window",
      "required": true
    }
  },
  "resources": {
    "successTemplate": {
      "kind": "image"
    }
  },
  "limits": {
    "activeMs": 600000,
    "steps": 10000,
    "callDepth": 8,
    "parallelCalls": 8,
    "inputEvents": 100000
  },
  "nodes": [
    {
      "id": "locate",
      "title": "定位完成提示",
      "action": "vision.match",
      "params": {
        "target": "main",
        "image": "successTemplate",
        "threshold": 0.92,
        "timeoutMs": 5000,
        "intervalMs": 200,
        "selection": "unique"
      },
      "on": {
        "next": "return",
        "error": "notReady"
      },
      "store": "matchResult"
    },
    {
      "id": "return",
      "title": "返回校验结果",
      "action": "flow.return",
      "params": {
        "values": {
          "ready": {
            "$expr": {
              "op": "notEqual",
              "args": [
                {
                  "$expr": {
                    "op": "path",
                    "path": [
                      "vars",
                      "matchResult",
                      "selected"
                    ]
                  }
                },
                null
              ]
            }
          }
        }
      },
      "on": {}
    },
    {
      "id": "notReady",
      "title": "返回未就绪",
      "action": "flow.return",
      "params": {
        "values": {
          "ready": false
        }
      },
      "on": {}
    }
  ],
  "extensions": {
    "studio.parameter-labels": {
      "month": "月份"
    },
    "studio.variable-labels": {
      "matchResult": "定位结果",
      "checkResult": "校验结果",
      "downloadComplete": "下载已完成"
    }
  }
}
