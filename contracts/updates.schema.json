{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:updates:1",
  "title": "DeskWeaveStudio 更新信任与签名资料 1.0",
  "$defs": {
    "key": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      },
      "required": [
        "keyId",
        "algorithm",
        "publicKey"
      ],
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "keyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "threshold",
        "keyIds"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "keyId",
        "signature"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "role": {
          "const": "root"
        },
        "formatVersion": {
          "const": "1.0"
        },
        "product": {
          "const": "DeskWeaveStudio"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "maxItems": 16,
          "minItems": 3
        },
        "roles": {
          "type": "object",
          "properties": {
            "root": {
              "$ref": "#/$defs/delegation"
            },
            "stable": {
              "$ref": "#/$defs/delegation"
            },
            "preview": {
              "$ref": "#/$defs/delegation"
            }
          },
          "required": [
            "root",
            "stable",
            "preview"
          ],
          "additionalProperties": false
        },
        "minimumSecuritySequence": {
          "type": "object",
          "properties": {
            "stable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "preview": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "stable",
            "preview"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "role",
        "formatVersion",
        "product",
        "version",
        "issuedAt",
        "expiresAt",
        "keys",
        "roles",
        "minimumSecuritySequence"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "windows-x64",
            "macos-x64",
            "macos-arm64",
            "linux-x64",
            "linux-arm64"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Windows 的签名发布者、macOS 的 Team ID，或 Linux 分发渠道签名密钥指纹；与客户端固定的对应平台发行身份核对。"
        },
        "components": {
          "type": "object",
          "properties": {
            "studio": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "agent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "bridge": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "studio",
            "engine",
            "agent",
            "bridge"
          ],
          "additionalProperties": false
        },
        "protocolVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "workspaceFormatMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "workspaceFormatMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "platform",
        "url",
        "length",
        "sha256",
        "publisher",
        "components",
        "protocolVersion",
        "workspaceFormatMin",
        "workspaceFormatMax"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "role": {
          "const": "release"
        },
        "formatVersion": {
          "const": "1.0"
        },
        "product": {
          "const": "DeskWeaveStudio"
        },
        "rootVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "role",
        "formatVersion",
        "product",
        "rootVersion",
        "channel",
        "sequence",
        "version",
        "issuedAt",
        "expiresAt",
        "artifact"
      ],
      "additionalProperties": false
    },
    "revocations": {
      "type": "object",
      "properties": {
        "role": {
          "const": "revocations"
        },
        "formatVersion": {
          "const": "1.0"
        },
        "product": {
          "const": "DeskWeaveStudio"
        },
        "rootVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedKeyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 128,
          "uniqueItems": true,
          "description": "仅可信根链已登记的在线通道发布键；不得包含根角色密钥。"
        },
        "revokedArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 1024,
          "uniqueItems": true
        },
        "minimumSecuritySequence": {
          "type": "object",
          "properties": {
            "stable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "preview": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "stable",
            "preview"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "role",
        "formatVersion",
        "product",
        "rootVersion",
        "version",
        "issuedAt",
        "expiresAt",
        "revokedKeyIds",
        "revokedArtifacts",
        "minimumSecuritySequence"
      ],
      "additionalProperties": false
    },
    "rootEnvelope": {
      "type": "object",
      "properties": {
        "signed": {
          "$ref": "#/$defs/root"
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "signed",
        "signatures"
      ],
      "additionalProperties": false
    },
    "releaseEnvelope": {
      "type": "object",
      "properties": {
        "signed": {
          "$ref": "#/$defs/release"
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "signed",
        "signatures"
      ],
      "additionalProperties": false
    },
    "revocationsEnvelope": {
      "type": "object",
      "properties": {
        "signed": {
          "$ref": "#/$defs/revocations"
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "signed",
        "signatures"
      ],
      "additionalProperties": false
    },
    "trustState": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": "1.0"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rootVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rootSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revocationsVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revocationsSha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "channelSequences": {
          "type": "object",
          "properties": {
            "stable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "preview": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "stable",
            "preview"
          ],
          "additionalProperties": false
        },
        "channelManifestHashes": {
          "type": "object",
          "properties": {
            "stable": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "preview": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "stable",
            "preview"
          ],
          "additionalProperties": false
        },
        "lastTrustedTime": {
          "type": "string",
          "format": "date-time"
        },
        "rootHistory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/acceptedRootReference"
          },
          "description": "从安装内置根锚到当前根的有序完整链；每个引用均对应本机按规范signed摘要封存的真实签名信封。"
        }
      },
      "required": [
        "formatVersion",
        "generation",
        "rootVersion",
        "rootSha256",
        "revocationsVersion",
        "revocationsSha256",
        "channelSequences",
        "channelManifestHashes",
        "lastTrustedTime",
        "rootHistory"
      ],
      "additionalProperties": false
    },
    "manualDowngradePlan": {
      "type": "object",
      "properties": {
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "targetSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rootVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revocationsVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "backupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "confirmationGrant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sourceVersion",
        "targetVersion",
        "targetSha256",
        "channel",
        "targetSequence",
        "rootVersion",
        "revocationsVersion",
        "backupId",
        "expiresAt",
        "confirmationGrant"
      ],
      "additionalProperties": false
    },
    "acceptedRootReference": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
