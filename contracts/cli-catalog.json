      "permissions": [],
      "completion": "result",
      "authorization": "可信本地选择器生成目标选择能力；命令不接受 HWND 或任意窗口标题作为权限。",
      "localBindings": {
        "selectionGrant": "target.select"
      },
      "fixedParams": {},
      "publishedOutputSchema": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "window",
              "display",
              "region",
              "desktop"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "topology": {
            "$ref": "urn:deskweave:recording:1#/$defs/topology"
          }
        },
        "required": [
          "displayName",
          "kind",
          "expiresAt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "desktop"
                }
              }
            },
            "then": {
              "required": [
                "topology"
              ]
            }
          }
        ]
      },
      "localResultBindings": {
        "targetToken": "selectedTarget"
      }
    },
