{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskweave:bridge-management:1",
  "title": "DeskWeaveStudio 本地接入管理 1.0",
  "$defs": {
    "publicServerConfig": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": [
            "stdio",
            "streamableHttp",
            "sse"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "allowedHosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "uniqueItems": true
        },
        "allowedOrigins": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "uniqueItems": true
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "certificateState": {
              "enum": [
                "none",
                "ready",
                "expired",
                "unavailable"
              ]
            },
            "certificateSha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notAfter": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "enabled",
            "certificateState",
            "certificateSha256",
            "notAfter"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "transport",
        "host",
        "port",
        "allowedHosts",
        "allowedOrigins",
        "tls"
      ],
      "additionalProperties": false
    },
    "bridgeSnapshot": {
      "type": "object",
      "properties": {
        "savedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "savedConfig": {
          "$ref": "#/$defs/publicServerConfig"
        },
        "activeVersion": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "activeConfig": {
          "oneOf": [
            {
              "$ref": "#/$defs/publicServerConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiresRestart": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "stopped",
            "starting",
            "listening",
            "stopping",
            "failed"
          ]
        }
      },
      "required": [
        "savedVersion",
        "savedConfig",
        "activeVersion",
        "activeConfig",
        "requiresRestart",
        "state"
      ],
      "additionalProperties": false
    },
    "tokenMetadata": {
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "enum": [
              "workflow.read",
              "workflow.write",
              "run.read",
              "run.execute",
              "run.control",
              "capture.read",
              "vision.local",
              "vision.remote",
              "asset.read",
              "asset.write",
              "observation.read",
              "observation.control",
              "desktop.input",
              "desktop.stop"
            ]
          },
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUsedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revokedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        }
      },
      "required": [
        "tokenId",
        "name",
        "permissions",
        "targets",
        "createdAt",
        "expiresAt",
        "lastUsedAt",
        "revokedAt",
        "state"
      ],
      "additionalProperties": false
    },
    "tokenListParams": {
      "type": "object",
      "properties": {
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "active",
              "expired",
              "revoked"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "cursor",
        "pageSize",
        "states"
      ],
      "additionalProperties": false
    },
    "tokenPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tokenMetadata"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "snapshotAt"
      ],
      "additionalProperties": false
    },
    "tokenImpactParams": {
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "tokenId",
        "cursor",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "tokenImpactPage": {
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "impactVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokenState": {
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "activeSessions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "resourceSubscriptions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "directInputPermits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "activeRuns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "activeSessions",
            "resourceSubscriptions",
            "directInputPermits",
            "activeRuns"
          ],
          "additionalProperties": false
        },
        "relatedRuns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "state": {
                "enum": [
                  "queued",
                  "preparing",
                  "running",
                  "pausing",
                  "paused",
                  "stopping",
                  "succeeded",
                  "failed",
                  "cancelled",
                  "interrupted"
                ]
              },
              "controlVersion": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "runId",
              "displayName",
              "state",
              "controlVersion"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "hiddenRunCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokenId",
        "snapshotId",
        "snapshotAt",
        "expiresAt",
        "impactVersion",
        "tokenState",
        "counts",
        "relatedRuns",
        "hiddenRunCount",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  }
}
