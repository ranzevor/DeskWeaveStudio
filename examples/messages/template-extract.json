{
  "protocolVersion": "1.0",
  "kind": "request",
  "id": "extract-demo",
  "session": "session-demo",
  "method": "template.extract",
  "workspace": "workspace-demo",
  "deadlineMs": 5000,
  "params": {
    "source": {
      "kind": "image",
      "assetVersion": "asset-version-demo"
    },
    "roi": null,
    "options": {
      "algorithms": {
        "contour": 0.6,
        "color": 0.3,
        "corner": 0.1
      },
      "minArea": 16,
      "maxArea": 262144,
      "minConfidence": 0.65,
      "minAspectRatio": 0.1,
      "maxAspectRatio": 10,
      "deduplication": {
        "iou": 0.7,
        "hashDistance": 8
      },
      "filterText": true,
      "maxCandidates": 2000,
      "timeoutMs": 120000
    }
  }
}
